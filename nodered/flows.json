    {
        "id": "sim_init_fn",
        "type": "function",
        "z": "sim_tab",
        "name": "init state and UNKNOWN",
        "func": "function uuid() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {\n    const r = Math.random() * 16 | 0;\n    return (c === 'x' ? r : (r & 3 | 8)).toString(16);\n  });\n}\nconst VEHICLES = [['BUS-DEMO-01', 'ramp-node-01'], ['BUS-DEMO-02', 'ramp-node-02']];\nconst expected = {};\nconst out = [];\nfor (const pair of VEHICLES) {\n  const vehicleId = pair[0];\n  const nodeId = pair[1];\n  const sessionId = uuid();\n  const runId = uuid();\n  expected[nodeId] = sessionId;\n  flow.set('sim_' + vehicleId, { nodeId: nodeId, vehicleId: vehicleId, sessionId: sessionId, sequence: 0, stowed: true, deployed: false, steps: [], cut: false, last: null, prev: null });\n  flow.set('proj_' + vehicleId, { runId: runId, projectionSequence: 1 });\n  flow.set('ingest_' + nodeId, undefined);\n  out.push({\n    topic: 'vehicles/' + vehicleId + '/ramp/state',\n    payload: { schemaVersion: 3, vehicleId: vehicleId, projectionRunId: runId, projectionSequence: 1, sourceSequence: 0, position: 'UNKNOWN', quality: 'STALE' }\n  });\n}\nflow.set('expected', expected);\nreturn [out];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 60,
        "wires": [
            [
                "sim_pub_proj"
            ]
        ]
    },
