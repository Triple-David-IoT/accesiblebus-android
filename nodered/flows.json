    {
        "id": "sim_fn",
        "type": "function",
        "z": "sim_tab",
        "name": "simulate",
        "func": "const VEHICLES = { 'BUS-DEMO-01': 'ramp-node-01', 'BUS-DEMO-02': 'ramp-node-02' };\nconst vehicleId = msg.vehicleId;\nconst nodeId = VEHICLES[vehicleId];\nconst s = flow.get('sim_' + vehicleId);\nif (!nodeId || !s) { return null; }\n\nfunction uuid() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {\n    const r = Math.random() * 16 | 0;\n    return (c === 'x' ? r : (r & 3 | 8)).toString(16);\n  });\n}\nfunction toMsg(sample) {\n  return { topic: 'telemetry/vehicles/' + vehicleId + '/ramp', payload: sample };\n}\nfunction fresh(stowed, deployed) {\n  s.stowed = stowed;\n  s.deployed = deployed;\n  s.sequence += 1;\n  const sample = {\n    schemaVersion: 3, nodeId: nodeId, vehicleId: vehicleId, sessionId: s.sessionId,\n    sequence: s.sequence, sourceMode: 'SIMULATED', stowedLimit: stowed, deployedLimit: deployed\n  };\n  s.prev = s.last;\n  s.last = sample;\n  return toMsg(sample);\n}\n\nconst out = [];\nconst events = [];\nconst cmd = msg.cmd;\nif (cmd === 'cut') {\n  s.cut = !s.cut;\n} else if (cmd === 'restart') {\n  s.sessionId = uuid();\n  s.sequence = 0;\n  s.stowed = true;\n  s.deployed = false;\n  s.steps = [];\n  s.cut = false;\n  s.last = null;\n  s.prev = null;\n  const expected = flow.get('expected') || {};\n  expected[nodeId] = s.sessionId;\n  flow.set('expected', expected);\n  flow.set('ingest_' + nodeId, undefined);\n  events.push({ topic: vehicleId, payload: 'restart' });\n} else if (!s.cut) {\n  if (cmd === 'tick') {\n    if (s.steps.length > 0) {\n      const next = s.steps.shift();\n      out.push(fresh(next[0], next[1]));\n    } else {\n      out.push(fresh(s.stowed, s.deployed));\n    }\n  } else if (cmd === 'normal') {\n    if (s.stowed && !s.deployed) { s.steps = [[false, false], [false, true]]; }\n    else if (!s.stowed && s.deployed) { s.steps = [[false, false], [true, false]]; }\n    else { s.steps = [[false, true]]; }\n    const first = s.steps.shift();\n    out.push(fresh(first[0], first[1]));\n  } else if (cmd === 'incomplete') {\n    s.steps = [];\n    out.push(fresh(false, false));\n  } else if (cmd === 'contradiction') {\n    s.steps = [];\n    out.push(fresh(true, true));\n  } else if (cmd === 'duplicate') {\n    if (s.last) { out.push(toMsg(s.last)); }\n  } else if (cmd === 'out_of_order') {\n    if (s.prev) { out.push(toMsg(s.prev)); }\n  }\n}\n\nflow.set('sim_' + vehicleId, s);\nnode.status({ fill: s.cut ? 'red' : 'green', shape: 'dot', text: vehicleId + (s.cut ? ' CUT' : ' seq ' + s.sequence) });\nreturn [out.length > 0 ? out : null, events.length > 0 ? events : null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 175,
        "wires": [
            [
                "sim_pub_tel",
                "sim_dbg_sample"
            ],
            [
                "sim_dbg_restart"
            ]
        ]
